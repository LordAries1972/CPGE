# Git and version control
.git
.gitignore
.gitattributes
.github

# IDE and editor files
.vscode
.idea
*.swp
*.swo
*~
*.sublime-project
.vs
.vscode/
*.code-workspace

# Build artifacts (keep source, exclude intermediates)
build/
build-android/
x64/
Debug/
Release/
*.o
*.obj
*.a
*.so
*.dll
*.exe
*.pdb
*.map
*.ilk
# Android packaging outputs (the Linux Docker build never uses them;
# the four APKs alone are ~520 MB of build context)
*.apk
*.idsig

# CMake cache
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# Temporary and log files
*.log
*.tmp
*.dmp
DebugLog.txt
Except-CallStack.log
/CrossPlatformGameEngine-report.txt

# Documentation and notes (optional; remove if docs should be included)
Docs/
AGENTS.md

# History/backup files
History/
*.bak

# OS-specific
.DS_Store
Thumbs.db
.directory

# Development and test directories (optional)
.agents
.claude
.codex

# Compiled shaders (will be recompiled in container)
*.cso
*.spv

# Video artifacts — recordings ONLY, not the shipped movies:
# Assets/cpge.mp4 is the SCENE_INTRO FOSS credit movie and
# Assets/test1.mp4 is a test movie; both must ship in the image, so
# there is no blanket *.mp4 exclusion here (the old one stripped them).
Assets/Playbacks/*.mp4
Assets/recording_*.mp4
recording.mp4

# User-specific files
*.user
CrossPlatformGameEngine.vcxproj.user

# Steam files (not needed in container)
steam/

# Node modules (if any package.json exists)
node_modules/

# Android project (Gradle project + packaging scripts + APKs, ~700 MB):
# the Linux Docker build never touches it.
Android/

# Dependencies that should be installed in container, not copied
# lib/ holds Windows-only .lib/.dll files (glew32.lib, glfw3.lib, ...)
# that the Linux build never uses. include/ MUST be copied, NOT excluded:
# GLM is vendored in include/glm/ and Linux/CMakeLists.txt fails the
# configure with a FATAL_ERROR if include/glm/glm.hpp is missing — the
# old `include/` exclusion here broke every docker build at configure
# time (fixed 25 Nov 2026, Phase C Dockerfile verification).
lib/
